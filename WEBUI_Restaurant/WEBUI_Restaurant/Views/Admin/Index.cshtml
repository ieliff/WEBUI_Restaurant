@{
    ViewData["Title"] = "Menü Listesi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; // Layout dosyasına referans
}

@model IEnumerable<MenuItem>

<h2>Menü Listesi</h2>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Fiyat</th>
            <th>Açıklama</th>
            <th>Fotoğraf</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Description</td>
                <td>
                    <img src="@item.ImagePath" alt="@item.Name" width="100" />
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

