@model About
<!-- Start About us -->
<section id="mu-about-us">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="mu-about-us-area">

                    <div class="mu-title">
                        <span class="mu-subtitle"></span>
                        <h2>@Model.Title</h2>
                    </div>

                           <div class="row">
                        <div class="col-md-6">
                            <div class="mu-about-us-left">
                                <img src="~/assets/img/@Model.ImageUrl" alt="img">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mu-about-us-right">
                                <p>@Model.Content</p>
                                <ul>
                                    
                                    <li>Yerel üreticilerden ürünler</li>
                                    <li>Nesilden nesile aktarılan tatlar</li>
                                    <li>Sağlıklı pişirme yöntemleri.</li>
                                    <li>Geniş menü çeşitliliği</li>
                                    <li>Özenli sunum.</li>
                                    <li>Bizim için her yemek, geçmişle geleceği bir sofrada buluşturmaktır..</li>
                                </ul>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End About us -->
